<?xml version="1.0"?>
<interfaceDefinition>
  <node name="show">
    <children>
      <node name="interfaces">
        <children>
          <node name="virtual-ethernet">
            <properties>
              <help>Show Virtual Ethernet interface information</help>
            </properties>
            <command>sudo ip --all netns exec ip link</command>
          </node>
        </children>
      </node>
    </children>
  </node>
</interfaceDefinition>
