name: Build and Deploy vyos-1x Package

on:
  pull_request:
    types: [closed]
  workflow_dispatch:

# env:
#   GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

jobs:
  build-and-deploy:
    if: github.event.pull_request.merged == true || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest

    container: vyos-build

    steps:
    - name: Checkout repository
      uses: actions/checkout@v3

    - name: Build VyOS package
      run: |
        cd vyos-1x
        debuild -us -uc -b

